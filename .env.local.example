DATABASE_URL=postgresql://postgres:postgres@postgres:5432/madras_menu_local

# Required, at least 32 characters (config.py) — generate your own with: openssl rand -hex 32
SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3000
# Embedding service (Ollama) URL
OLLAMA_BASE_URL=http://localhost:11434
