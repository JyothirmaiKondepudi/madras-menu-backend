DATABASE_URL=postgresql://postgres:postgres@postgres:5432/madras_menu_local

# Required, at least 32 characters (config.py) — generate your own with: openssl rand -hex 32
SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3000
# Embedding service (Ollama) URL
OLLAMA_BASE_URL=http://localhost:11434
# Database connection pool, per instance: at most DB_POOL_SIZE + DB_MAX_OVERFLOW connections
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
DB_CONNECTION_TIMEOUT=5
